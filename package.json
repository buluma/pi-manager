{
	"private": true,
	"packageManager": "pnpm@10.30.2",
	"scripts": {
		"build": "pnpm -r run build",
		"build:fast": "pnpm -r run build:fast",
		"typecheck": "pnpm --filter @ifi/pi-man-core build && pnpm -r --filter @ifi/pi-man-crews --filter @ifi/pi-man-core --filter @ifi/pi-man-cli --filter @ifi/pi-spec --filter @ifi/pi-web-client --filter @ifi/pi-web-server run typecheck",
		"verify:completion": "pnpm exec vitest run packages/crews/tests/commands.test.ts",
		"security:allowlist": "node ./scripts/security/check-dependency-allowlist.mjs",
		"security:audit:prod": "pnpm audit --prod --audit-level=high --ignore-unfixable",
		"security:audit:dev": "pnpm audit -D --audit-level=high --ignore-unfixable",
		"security:check": "pnpm security:allowlist && pnpm security:audit:prod && pnpm security:audit:dev",
		"test": "vitest run",
		"verify:compiled-tarballs": "node ./scripts/verify-compiled-tarballs.mjs",
		"verify:published-packages": "node ./scripts/verify-published-packages.mjs",
		"verify:pi-compat": "node ./scripts/verify-pi-compat.mjs",
		"mdt": "mdt",
		"docs:list": "pnpm mdt list",
		"docs:update": "pnpm mdt update",
		"docs:check": "pnpm mdt check",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"check": "biome ci --error-on-warnings ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@ifi/mdt": "^0.7.0",
		"@earendil-works/pi-agent-core": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@earendil-works/pi-tui": "1.1.0",
		"typebox": "1.3.27",
		"@types/node": "^22.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260305.1",
		"typescript": "^5.7.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
