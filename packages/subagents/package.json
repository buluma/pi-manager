{
  "name": "@ifi/pi-extension-subagents",
  "version": "0.4.5",
  "description": "Full-featured subagent orchestration extension for pi, built on top of nicobailon/pi-subagents.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "multi-agent",
    "chains",
    "delegation"
  ],
  "bin": {
    "pi-extension-subagents": "install.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts",
      "./notify.ts"
    ]
  },
  "files": [
    "*.ts",
    "*.mjs",
    "agents",
    "README.md",
    "banner.png",
    "!*.test.ts",
    "!test/**"
  ],
  "license": "MIT",
  "dependencies": {
    "@buluma/pi-man-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifiokjr/pi-man.git",
    "directory": "packages/subagents"
  },
  "homepage": "https://github.com/ifiokjr/pi-man/tree/main/packages/subagents",
  "bugs": {
    "url": "https://github.com/ifiokjr/pi-man/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
